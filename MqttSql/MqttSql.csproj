<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <Platforms>AnyCPU</Platforms>
    <Authors>Guiorgy</Authors>
    <Company>Ecopre</Company>
    <Product>MQTT to SQLite</Product>
    <Description>Windows Service that subscribes to MQTT brokers and writes the messages to local SQLite databases</Description>
    <Copyright>Ecopre</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationIcon>mqttsql.ico</ApplicationIcon>
    <Configurations>Debug;Release</Configurations>
    <Version>2.0.0</Version>
    <PackageProjectUrl>https://github.com/Guiorgy/MqttSql</PackageProjectUrl>
    <PackageIcon>mqttsql.ico</PackageIcon>
    <PackageIconUrl />
    <RepositoryUrl>https://github.com/Guiorgy/MqttSql</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);$(Define.Replace(",",";"))</DefineConstants>
    <DockerfileTag>guiorgy/mqttsql</DockerfileTag>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..</DockerfileContext>
    <DockerfileFastModeStage>debug-base</DockerfileFastModeStage>
    <DockerComposeUpArguments>--timeout 60</DockerComposeUpArguments>
    <DockerComposeDownArguments>--timeout 60</DockerComposeDownArguments>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <Target Name="SetGitRevision" BeforeTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <GitRevision>$([System.Environment]::GetEnvironmentVariable('GIT_COMMIT'))</GitRevision>
    </PropertyGroup>
    <Exec Command="git describe --long --always --dirty=* --exclude=* --abbrev=64" ConsoleToMSBuild="True" IgnoreExitCode="False" Condition="'$(GitRevision)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitRevision" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitRevision" Value="$(GitRevision)" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <ErrorReport>prompt</ErrorReport>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="mqttsql.ico">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonMultiNameModifier" Version="1.0.2.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="MQTTnet" Version="[3.1.2]" />
    <PackageReference Include="Npgsql" Version="9.0.1" />
    <PackageReference Include="SingleOrArrayJsonConverter" Version="1.0.1.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceGenerators\SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
